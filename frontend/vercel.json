{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://imao-backend.onrender.com/api/$1"
    },
    {
      "source": "/",
      "destination": "/login/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/connected",
      "destination": "/dashboard/index.html"
    }
  ]
}
