# Copy to .env and fill in values for THIS laptop.
# Never commit .env or real network settings.

APP_ENV=development
APP_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DATABASE_PATH=./database/imao.sqlite3

# Network interfaces: identify these on the host before enabling firewall changes.
UPSTREAM_INTERFACE=REPLACE_WITH_ETHERNET_INTERFACE
HOTSPOT_INTERFACE=REPLACE_WITH_WIFI_INTERFACE

# The hotspot subnet and gateway are installation-specific.
HOTSPOT_CIDR=REPLACE_WITH_HOTSPOT_CIDR
HOTSPOT_GATEWAY=REPLACE_WITH_GATEWAY_ADDRESS

# Wi-Fi access point settings (configure locally before rendering).
HOTSPOT_SSID=REPLACE_WITH_WIFI_NETWORK_NAME
HOTSPOT_PASSPHRASE=REPLACE_WITH_WIFI_PASSWORD
WIFI_COUNTRY_CODE=REPLACE_WITH_TWO_LETTER_COUNTRY_CODE

PORTAL_HOST=0.0.0.0
PORTAL_PORT=8000
COOKIE_SECURE=false

DEFAULT_QUOTA_MB=500
SESSION_POLL_SECONDS=10
SESSION_STALE_MINUTES=5

# Keep firewall management disabled until the network has been verified.
FIREWALL_BACKEND=none
FIREWALL_ENABLED=false
