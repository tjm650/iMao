# Rendered by scripts/imao-network.py.
interface={{HOTSPOT_INTERFACE}}
bind-dynamic
dhcp-authoritative
dhcp-range={{HOTSPOT_DHCP_START}},{{HOTSPOT_DHCP_END}},12h
dhcp-option=option:router,{{HOTSPOT_GATEWAY}}
dhcp-option=option:dns-server,{{HOTSPOT_GATEWAY}}
domain-needed
bogus-priv
# dnsmasq uses the host's configured upstream resolvers from resolv.conf.
# Do not use this file until the hotspot interface has its static gateway address.
