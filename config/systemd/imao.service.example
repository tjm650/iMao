[Unit]
Description=iMao captive portal and voucher manager
Documentation=https://github.com/tjm650/iMao
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=imao
Group=imao
WorkingDirectory=/opt/imao
EnvironmentFile=/etc/imao/imao.env
# Safe default: loopback only. Change deliberately after reviewing the gateway
# listener, Caddy proxy and firewall design.
ExecStart=/opt/imao/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077

# The restricted netctl helper is invoked through a narrow sudoers rule.
# Keep sudoers limited to /usr/local/sbin/imao-netctl and review this trade-off.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=imao
StateDirectoryMode=0750
ReadWritePaths=/var/lib/imao

[Install]
WantedBy=multi-user.target
